# Local development uses embedded PGlite when DATABASE_URL is empty.
HOST=127.0.0.1
PORT=3100
PUBLIC_ORIGIN=http://127.0.0.1:4180
DATABASE_URL=
DATABASE_SSL=false
COOKIE_SECURE=false
SESSION_DAYS=7
LOGIN_WINDOW_MINUTES=15
LOGIN_ACCOUNT_LIMIT=5
LOGIN_IP_LIMIT=20

# AMap console: create a Web Service API key (not a Web JS API key).
AMAP_WEB_SERVICE_KEY=

# Production values used by deployment/docker-compose.yml
DOMAIN=skills.example.com
POSTGRES_DB=skill_share
POSTGRES_USER=skill_share
POSTGRES_PASSWORD=replace-with-a-long-random-password
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# Optional: serve HTTPS directly from Node instead of Caddy.
TLS_KEY_PATH=
TLS_CERT_PATH=
